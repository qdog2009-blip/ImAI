# ============================================================
# ImAI 私有 IM 系统 — 环境变量配置模板
# 复制本文件为 .env 并填入真实值：cp .env.example .env
# 严禁将 .env 提交至 Git！
# ============================================================

# -------------------- 应用基础 --------------------
APP_NAME=ImAI
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# -------------------- 安全与认证 --------------------
SERVER_SECRET_KEY=           # 客户端连接校验用的服务器密钥
JWT_SECRET_KEY=              # JWT 签名密钥
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -------------------- 数据库 (策略+工厂模式) --------------------
DB_TYPE=sqlite               # sqlite | postgres

# SQLite (轻量级 / NAS / 开发环境)
SQLITE_PATH=./data/imai.db

# PostgreSQL (生产环境)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=imai

# -------------------- 缓存 (策略+工厂模式) --------------------
CACHE_TYPE=file              # file | redis

# 文件缓存 (轻量级)
FILE_CACHE_DIR=./data/cache

# Redis (高并发 / 生产环境)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -------------------- 存储 (文件/媒体) --------------------
STORAGE_TYPE=local           # local | s3

# 本地文件存储
LOCAL_STORAGE_DIR=./data/uploads

# S3 / MinIO
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=

# -------------------- LLM / AI 机器人 --------------------
LLM_PROVIDER=openclaw       # openclaw | deepseek | openai
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_TIMEOUT=30
LLM_STREAM_ENABLED=false

# -------------------- 推送服务 --------------------
PUSH_PROVIDER=none           # none | jpush | mobpush
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
MOBPUSH_APP_KEY=
MOBPUSH_APP_SECRET=

# -------------------- Webhook 分发 --------------------
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

# -------------------- WebSocket --------------------
WS_HEARTBEAT_INTERVAL=30    # Ping/Pong 心跳间隔 (秒)
WS_MAX_CONNECTIONS_PER_USER=3
