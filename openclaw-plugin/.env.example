# ============================================================
#  OpenClaw Channel Plugin — 配置模板
#  将本文件复制为 .env 并填写真实值
# ============================================================

# -------------------- ImAI 服务器 --------------------
# 服务器 HTTP 地址 (不含末尾斜杠)
IMAI_SERVER_URL=http://localhost:8000

# 服务器密钥 (与 ImAI 服务端 SERVER_SECRET_KEY 保持一致)
IMAI_SERVER_SECRET_KEY=your-server-secret-key

# 插件在 ImAI 上的账号凭证
IMAI_USERNAME=openclaw
IMAI_PASSWORD=your-password

# 设备标识 (唯一字符串，用于多设备管理)
IMAI_DEVICE_ID=openclaw-plugin-001

# -------------------- OpenClaw API --------------------
# OpenClaw 对话接口基础地址 (兼容 OpenAI Chat Completions 格式)
OPENCLAW_API_BASE_URL=https://api.openclaw.ai/v1

# OpenClaw API 密钥
OPENCLAW_API_KEY=your-openclaw-api-key

# 使用的模型名称
OPENCLAW_MODEL=openclaw-chat

# 请求超时 (秒)
OPENCLAW_TIMEOUT=60

# 系统提示词 (可选，用于定义 AI 角色)
OPENCLAW_SYSTEM_PROMPT=你是一个智能助手，请用简洁、友好的方式回答用户的问题。

# -------------------- 插件行为 --------------------
# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 断线重连间隔 (秒)
RECONNECT_INTERVAL=5

# 最大重连次数 (0 = 无限重连)
MAX_RECONNECT_ATTEMPTS=0
